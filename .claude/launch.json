{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "flutter-app",
      "runtimeExecutable": "flutter",
      "runtimeArgs": ["run", "-d", "emulator-5554", "--pid-file", ".flutter-pid"],
      "port": 8080,
      "cwd": "boda_mapato"
    },
    {
      "name": "flutter-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": ["run", "-d", "web-server", "--web-port", "8090"],
      "port": 8090,
      "cwd": "boda_mapato"
    },
    {
      "name": "backend-mapato",
      "runtimeExecutable": "php",
      "runtimeArgs": ["artisan", "serve", "--host=127.0.0.1", "--port=8000"],
      "port": 8000,
      "cwd": "backend_mapato"
    }
  ]
}
