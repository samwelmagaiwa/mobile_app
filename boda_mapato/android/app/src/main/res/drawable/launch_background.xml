<?xml version="1.0" encoding="utf-8"?>
<!-- Native OS splash, shown before the Flutter engine draws its first
     frame -- can't animate at this layer, so it just matches the app's
     brand gradient and centers the launcher icon, then hands off
     instantly to the real animated splash (AppSplashScreen). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#17D3C6"
                android:centerColor="#3A2ED9"
                android:endColor="#0B0B1E" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/launcher_icon" />
    </item>
</layer-list>
